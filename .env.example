# ──────────────────────────────────────────────────────────────────────────────
# Indiyan Payments — environment
# Copy to .env.local (development) or set in the host's environment (production).
# Every variable without NEXT_PUBLIC_ is server-only and never reaches the browser.
# ──────────────────────────────────────────────────────────────────────────────

# The one tenant this portal serves on the shared remote payments API.
# Every upstream call is scoped to it; it is never taken from the browser.
MASTER_CLIENT_ID=

# Remote clients API (every action is a POST returning {status, statusCode, message, data}).
REMOTE_API_BASE_URL=http://172.198.160.73/clients/api/
REMOTE_API_TIMEOUT_MS=20000

# BBPS bill-payment service (credit card bills).
BBPS_BILLERS_URL=https://nammapayments.in/v5bc/api/aeps/bpay_SelectBillCategory
BBPS_FETCH_BILL_URL=https://nammapayments.in/v5bc/api/aeps/bpay_FetchBillSingle
BBPS_TIMEOUT_MS=30000

# Where the payment gateway sends the payer back. Empty = this request's own origin.
PG_REDIRECT_BASE_URL=

# Session cookie signing secret — at least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# A sign-in lasts until midnight in this time zone.
APP_TIMEZONE=Asia/Kolkata

# Folder for small local files (retailer QR remarks). Keep it outside the deploy folder
# so a redeploy does not erase it.
STORAGE_PATH=./.data

# Feature switches (true = switched off). Reports of past payments are never affected.
NEXT_PUBLIC_PAY_OUT_DISABLED=false
NEXT_PUBLIC_STATIC_QR_DISABLED=false
